#!/bin/sh
# svm — sbox 容器 Supervisor 交互菜单
CTL="supervisorctl -c /etc/supervisord.conf"

progs() { $CTL status | awk '{print $1}'; }

tail_log() {
    p=$1
    for f in /var/log/sup/$p.log; do
        [ -f "$f" ] && { echo "── tail -n 40 $f ──"; tail -n 40 "$f"; return; }
    done
    echo "(无日志文件,该程序输出直接进容器控制台;看实时日志: docker logs -f 容器 或面板日志)"
}

while :; do
    clear 2>/dev/null || true
    echo "═══════════ Supervisor 服务管理 (svm) ═══════════"
    i=0
    $CTL status | awk '{printf "  %d) %-8s %s %s\n", NR, $1, $2, $3}'
    n=$(progs | wc -l | tr -d ' ')
    echo
    echo "  a) start全部   x) stop全部   r) restart全部"
    echo "  g) supervisorctl 原生命令   q) 退出"
    printf "输入编号[1-%s]或字母: " "$n"
    read -r c
    case "$c" in
        q|Q) break;;
        a) $CTL start all;;
        x) $CTL stop all;;
        r) $CTL restart all;;
        g) printf "supervisorctl> "; read -r sc; eval "$CTL $sc"; sleep 1;;
        *[!0-9]*|"") ;;
        *)
            if [ "$c" -ge 1 ] 2>/dev/null && [ "$c" -le "$n" ] 2>/dev/null; then
                p=$(progs | sed -n "${c}p")
                echo
                echo "── 程序 [$p] ──  1)start 2)stop 3)restart 4)日志 5)tail -f 日志 0)返回"
                printf "选择: "
                read -r a
                case "$a" in
                    1) $CTL start "$p";;
                    2) $CTL stop "$p";;
                    3) $CTL restart "$p";;
                    4) tail_log "$p";;
                    5) tail -f /var/log/sup/"$p".log;;
                esac
            fi;;
    esac
    [ "$c" != "" ] && { printf "\n(回车继续)"; read -r _; }
done
echo "bye"
